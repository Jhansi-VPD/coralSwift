# Supabase Configuration (public website reads; also used by API routes if present)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# FastAPI Backend
# Local dev: the uvicorn server from backend/ (run: python run.py)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: the deployed FastAPI service origin, e.g.
# NEXT_PUBLIC_API_URL=https://api.coralswift.com

# Admin Default Credentials (FastAPI-side legacy admin login fallback)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Site URL
NEXT_PUBLIC_SITE_URL=https://coralswift.com
