# =============================================================================
# CORALSWIFT FASTAPI BACKEND — ENVIRONMENT
# Copy to backend/.env and fill in. Never commit .env.
# =============================================================================

# --- App ---
APP_NAME=CoralSwift API
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# --- Supabase (same project the frontend uses) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Database (optional; only for direct Postgres access / future Alembic) ---
# DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# --- Legacy admin fallback credentials (optional; Supabase Auth takes precedence) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password

# --- Legacy HMAC session signing (for the legacy admin JWT issued at login) ---
ADMIN_SESSION_SECRET=generate-a-long-random-string

# --- Security (reserved for future server-side JWT issuing) ---
SECRET_KEY=generate-another-long-random-string

# --- CORS: allowed frontend origins, comma-separated (never "*" in production) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# --- Server ---
# 127.0.0.1 = local dev only; 0.0.0.0 exposes to your network / containers.
HOST=127.0.0.1
PORT=8000
# If 8000 is taken: PORT=8001 here, and set the frontend's
# NEXT_PUBLIC_API_URL=http://localhost:8001 to match.
RELOAD=true
